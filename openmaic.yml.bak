providers:
  litellm:
    preset: openai-compatible
    baseUrl: ${LITELLM_BASE_URL}
    apiKey: ${LITELLM_API_KEY}
    models: [claude-sonnet-5.5, claude-haiku-5.5, gemini-3.8-flash, gpt-6.2-sol, gpt-6.1-terra, gpt-6-luna, gpt-5.4]
  litellm-tts:
    preset: openai-tts
    baseUrl: ${LITELLM_BASE_URL}
    apiKey: ${LITELLM_API_KEY}
    models: [gpt-4o-mini-tts]
  litellm-asr:
    preset: openai-whisper
    baseUrl: ${LITELLM_BASE_URL}
    apiKey: ${LITELLM_API_KEY}
    models: [gpt-4o-transcribe, gemini-3.5-transcribe]
  litellm-image:
    preset: openai-image
    baseUrl: ${LITELLM_BASE_URL}
    apiKey: ${LITELLM_API_KEY}
    models: [gpt-image-2, gpt-image-1-mini, gemini-3.1-flash-image]

slots:
  llm: litellm:claude-sonnet-5.5
  tts: litellm-tts:gpt-4o-mini-tts
  asr: litellm-asr:gpt-4o-transcribe
  image: litellm-image:gpt-image-2
  # agent / classroom inherit llm
